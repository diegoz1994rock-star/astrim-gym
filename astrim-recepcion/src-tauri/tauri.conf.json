{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASTRIM GYM Recepción",
  "version": "0.1.0",
  "identifier": "com.astrimgym.recepcion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ASTRIM GYM Recepción",
        "width": 1024,
        "height": 768,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
