# Configuración de Firebase para el PANEL (SDK Web dentro del WebView de Tauri).
# Copia este archivo a `.env.local` (no se versiona) y completa los valores del
# proyecto Firebase. TODOS son públicos por diseño — la seguridad la dan las
# Firestore Security Rules, no el secreto de estas claves.
#
# Dónde sacarlos: Firebase Console -> Configuración del proyecto -> Tus apps ->
# app Web -> "SDK setup and configuration" -> objeto firebaseConfig.
# Ver docs/FIREBASE.md para el paso a paso completo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
